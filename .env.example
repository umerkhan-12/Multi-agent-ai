# ════════════════════════════════════════════════════════
#   Multi-Agent AI System — Environment Variables
#   Copy this file to .env and fill in your API keys
#   cp .env.example .env
# ════════════════════════════════════════════════════════

# ─── Claude (Anthropic) ──────────────────────────────────
# Free credits on sign-up: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── GPT-4 (OpenAI) ──────────────────────────────────────
# $5 free credits for new accounts: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Optional: change model (default: gpt-3.5-turbo)
# OPENAI_MODEL=gpt-4o

# ─── Gemini (Google) — COMPLETELY FREE tier ──────────────
# 15 requests/min, 1M tokens/day FREE: https://ai.google.dev
GOOGLE_API_KEY=your_google_api_key_here

# ─── Llama 3 via Groq — COMPLETELY FREE tier ─────────────
# 14,400 requests/day FREE: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ════════════════════════════════════════════════════════
#   AI Marketing Team (marketing_team/) — all optional.
#   With no keys at all it runs in offline demo mode.
# ════════════════════════════════════════════════════════
# LLM: gemini | groq | claude | offline  (auto-picks the first key it finds, free tiers first)
# MT_LLM_PROVIDER=gemini
# MT_GEMINI_MODEL=gemini-2.5-flash
# MT_GROQ_MODEL=llama-3.3-70b-versatile
# MT_CLAUDE_MODEL=claude-opus-5-5
MT_BRAND_NAME=Jev Fitness
MT_DAILY_BUDGET_USD=2
MT_DAILY_LLM_CALLS=200
# Shared secret n8n sends as X-API-Key (leave empty for local dev)
MT_API_KEY=

# ─── WhatsApp Cloud API (free tier) ─────────────────────
# developers.facebook.com → Create app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OWNER_NUMBER=          # your number, country code, no +  e.g. 923001234567
WHATSAPP_VERIFY_TOKEN=pick-any-random-string

# ─── Optional channels ──────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
