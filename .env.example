# ════════════════════════════════════════════════════════
#   Multi-Agent AI System — Environment Variables
#   Copy this file to .env and fill in your API keys
#   cp .env.example .env
# ════════════════════════════════════════════════════════

# ─── Claude (Anthropic) ──────────────────────────────────
# Free credits on sign-up: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── GPT-4 (OpenAI) ──────────────────────────────────────
# $5 free credits for new accounts: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Optional: change model (default: gpt-3.5-turbo)
# OPENAI_MODEL=gpt-4o

# ─── Gemini (Google) — COMPLETELY FREE tier ──────────────
# 15 requests/min, 1M tokens/day FREE: https://ai.google.dev
GOOGLE_API_KEY=your_google_api_key_here

# ─── Llama 3 via Groq — COMPLETELY FREE tier ─────────────
# 14,400 requests/day FREE: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
